# ==============================================================================
# PX CUSTON — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (EXEMPLO DE PRODUÇÃO / SANDBOX)
# NUNCA versione chaves secretas reais neste arquivo.
# ==============================================================================

# --- RUNTIME & HOSTINGER SERVER (BACKEND ONLY) ---
NODE_ENV="production"
PX_ENVIRONMENT="production"
PORT="3000"
APP_URL="https://seu-dominio-oficial.com.br"

# --- AI STUDIO RUNTIME (OPCIONAL) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- SUPABASE CONFIGURATION (POSTGRESQL & AUTH) ---
# Variáveis de servidor (Backend):
SUPABASE_URL=https://jivviwvpjxzhbpbmqmxm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7WZVS9yF_pXqv5PPTPq1Kw_gIL7mvgy
# OBRIGATÓRIO EM PRODUÇÃO (exclusivo do backend; nunca expor no frontend):
SUPABASE_SECRET_KEY="your-supabase-service-role-secret"
# Alias opcional suportado pelo backend caso SUPABASE_SECRET_KEY não seja definido:
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret"
SUPABASE_JWKS_URL=https://jivviwvpjxzhbpbmqmxm.supabase.co/auth/v1/.well-known/jwks.json

# Variáveis públicas para o bundle Vite (Frontend):
VITE_SUPABASE_URL=https://jivviwvpjxzhbpbmqmxm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7WZVS9yF_pXqv5PPTPq1Kw_gIL7mvgy

# --- SUPER ADMIN BOOTSTRAP SECURITY (BACKEND ONLY) ---
# Token forte (mínimo 32 caracteres aleatórios) exclusivo para inicialização do 1º SUPER_ADMIN
PX_SUPER_ADMIN_INIT_TOKEN="generate-a-secure-random-32-chars-token-for-super-admin-init"
# Alias opcional legado suportado pelo inicializador:
SUPABASE_INIT_SECRET=""

# --- MERCADO PAGO CONFIGURATION ---
# Chave pública (TEST-... em Sandbox ou APP_USR-... em Produção):
MP_PUBLIC_KEY="APP_USR-your-public-key"
VITE_MP_PUBLIC_KEY="APP_USR-your-public-key"
# OBRIGATÓRIO PARA COBRANÇA PIX REAL E CONCILIAÇÃO (exclusivo do backend):
MP_ACCESS_TOKEN="APP_USR-your-access-token"
# OBRIGATÓRIO EM PRODUÇÃO PARA VALIDAÇÃO HMAC-SHA256 DO WEBHOOK (exclusivo do backend):
MP_WEBHOOK_SECRET="your-webhook-secret"
# Opcionais (integrações OAuth / avulsas do Mercado Pago):
MP_CLIENT_ID="your-client-id"
MP_CLIENT_SECRET="your-client-secret"
# Opcional: caminho customizado para o cache local de configurações de pagamento (padrão: ./data/payment-settings.json)
PX_PAYMENT_SETTINGS_PATH=""

# --- SMTP CONFIGURATION (SERVER-SIDE EMAIL NOTIFICATIONS) ---
# Credenciais privadas de envio transacional (Hostinger / SMTP TLS). Nunca expor no frontend.
SMTP_HOST="smtp.your-provider.example"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="no-reply@your-domain.example"
SMTP_PASS="your-smtp-secret-password-placeholder"
SMTP_FROM="PX CUSTON <no-reply@your-domain.example>"

# --- SCRIPTS DE MIGRAÇÃO E HOMOLOGAÇÃO CLI (OPCIONAL, APENAS CLI) ---
DATABASE_URL=""
SUPABASE_DB_URL=""
STAGING_SUPABASE_URL=""
STAGING_SUPABASE_KEY=""
